# SpamMailD ayarları. Bu dosyayı .env olarak kopyalayın ve doldurun.

# /v1 uç noktaları için anahtar. Boşsa sunucu başlamaz.
API_KEY=
# Yalnız yerel geliştirme: true iken API_KEY olmadan başlar ve uç noktalar anahtarsız açıktır.
ALLOW_NO_AUTH=false

# Kimlik sonuçlarının okunacağı alıcı sunucu (ör. Gmail için mx.google.com).
TRUSTED_AUTHSERV_ID=mx.google.com

# true iken VirusTotal, URLhaus ve ClamAV kapalıdır.
DEMO_MODE=false

# VirusTotal: önce yalnız sha256 sorgulanır. Yükleme yalnız VT_UPLOAD=true ise yapılır.
VT_API_KEY=
VT_UPLOAD=false
# Yüklemeden sonra analiz sonucunu en çok bu kadar sor (her deneme öncesi bekleme, saniye).
VT_POLL_ATTEMPTS=3
VT_POLL_INTERVAL_S=5

# URLhaus (https://auth.abuse.ch/ adresinden alınan Auth-Key) ve yerel OpenPhish feed dosyası.
# URLhaus'a mail içindeki bağlantı adresleri (# kısmı hariç, sorgu parametreleri dahil) gider.
URLHAUS_AUTH_KEY=
OPENPHISH_FEED_PATH=

# clamd INSTREAM (docker compose içinde servis adı: clamav).
CLAMD_HOST=clamav
CLAMD_PORT=3310

# İçerik modeli: legacy-lr | baseline-char | onnx-transformer
MODEL_BACKEND=legacy-lr
MODEL_PATH=models/legacy-lr
TRANSFORMER_MODEL_NAME=jhu-clsp/mmBERT-base

# Sınırlar
RATE_LIMIT_PER_MINUTE=30
# MAX_REQUEST_MB yalnız /v1/analyze (ekli ham mail); diğer yollar MAX_TEXT_REQUEST_MB kullanır.
MAX_REQUEST_MB=70
MAX_TEXT_REQUEST_MB=2
MAX_ATTACHMENT_MB=25
MAX_TOTAL_ATTACHMENTS_MB=50

# Yalnız client.py için (Gmail uygulama şifresi; normal parola ile IMAP girişi kapalı).
EMAIL_ACCOUNT=
EMAIL_APP_PASSWORD=
SPAMMAILD_API_URL=http://127.0.0.1:8100
